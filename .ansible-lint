---

quiet: true
skip_list:
  - 'package-latest'
  - 'risky-shell-pipe'
  # The one-file-per-control-band layout puts 149 tasks in WN22-00-xxxxxx.yml and 136 in
  # WN22-AU-xxxxxx.yml, over the rule's hard-coded 100. The limit is not configurable:
  # max_tasks is a runtime option that the config-file schema rejects, and there is no CLI
  # flag. Splitting the bands is the only way to satisfy the rule and would break the naming
  # convention shared with the sibling Windows roles.
  # NOTE: this disables the rule repo-wide, so a new file crossing 100 tasks is not reported.
  - 'complexity'
use_default_rules: true
verbosity: 0
